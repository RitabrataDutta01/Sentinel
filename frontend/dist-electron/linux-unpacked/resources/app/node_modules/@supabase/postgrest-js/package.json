    "@jest/types": "^30.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.9",
    "chokidar-cli": "^3.0.0",
    "jest": "30.4.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.9",
    "tsdown": "^0.18.0",
    "tstyche": "^4.3.0",
    "type-fest": "^4.32.0",
    "typedoc": "^0.27.9",
    "typescript": "~5.8.3",
    "zod": "^3.25.76"
  },
